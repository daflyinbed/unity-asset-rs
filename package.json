{
  "name": "unity-asset-rs",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "main": "dist-electron/main.js",
  "scripts": {
    "api:schema": "cargo run --quiet -- openapi -o app/api/openapi.json",
    "api:generate": "pnpm api:schema && openapi-typescript app/api/openapi.json -o app/api/schema.d.ts",
    "dev": "REMOTE_DEBUGGING_PORT=9223 vite",
    "build": "vue-tsc -b && vite build --app",
    "native:rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "pnpm native:rebuild",
    "start": "electron .",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@iconify-json/lucide": "^1.2.118",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@unocss/eslint-plugin": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "@xwbx/eslint-config": "^0.14.0",
    "electron": "^43.1.1",
    "eslint": "^10.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2",
    "unocss": "^66.7.5",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vue-tsc": "^3.3.5"
  }
}
